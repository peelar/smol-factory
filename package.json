{
  "name": "smol-factory",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test tests tui",
    "tui": "bun tui/main.tsx",
    "tui:demo": "bun tui/main.tsx --demo",
    "test:tui": "bun test tui",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write '{src,scripts,tests,tui}/**/*.{ts,tsx}' package.json tsconfig.json",
    "smol": "bun scripts/smol.ts"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-rc.118",
    "@opentui/core": "0.5.11",
    "@opentui/react": "0.5.11",
    "effect": "4.0.0-rc.118",
    "react": "19.2.4"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "@types/react": "19.2.14",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "version": "0.1.0",
  "bin": {
    "smol": "scripts/smol.ts"
  },
  "files": [
    "src",
    "scripts",
    "skills/smol-factory",
    "tui",
    "README.md",
    "configuration.md",
    "assessment-contract.md",
    "tsconfig.json"
  ]
}
